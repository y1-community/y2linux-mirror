--- a/src/rtp.c
+++ b/src/rtp.c
@@ -8,10 +8,13 @@
 /* IWYU pragma: no_include "config.h" */
 
 #include <endian.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
+#include <time.h>
 
 #include "shared/defs.h"
+#include "shared/rt.h"
 #include "shared/log.h"
 
 /**
@@ -88,6 +91,52 @@
 	rtp->ts_rtp_clockrate = rtp_clockrate;
 	rtp->ts_offset = rand();
 
+	rtp->y2_anchored = false;
+
+}
+
+/* Y2: how far the RTP timestamp may fall behind real time before it jumps
+ * forward (AirPods Pro crackled at ~100 ms behind, went silent at ~160 ms). */
+#define Y2_RTP_SLACK_MS 40
+
+/* Y2: keep a sending stream's timestamp on real time. The PCM can stop for a
+ * while without the stream stopping: a drop between tracks (~50 ms each), or
+ * a pause while the stream is kept started (bluealsad --keep-alive). Counting
+ * only the frames sent left every later packet that much behind real time,
+ * and a sink that plays by the timestamp (AirPods Pro) dropped them as late:
+ * crackle after two skips, silence after three (Y2Linux owner's player,
+ * 2026-11-04). The timestamp now jumps over such a gap; it never goes back. */
+static void y2_rtp_follow_real_time(struct rtp_state *rtp) {
+
+	struct timespec now;
+	/* The clock the encoders pace with (asrsync): an adjusted clock would
+	 * drift from it and move the timestamp with no gap at all. */
+	if (rtp->ts_pcm_samplerate == 0 || gettimestamp(&now) != 0)
+		return;
+
+	if (!rtp->y2_anchored) {
+		const uint64_t sent_ns = (uint64_t)rtp->ts_pcm_frames * 1000000000 /
+			rtp->ts_pcm_samplerate;
+		const uint64_t now_ns = (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+		const uint64_t anchor_ns = now_ns > sent_ns ? now_ns - sent_ns : 0;
+		rtp->y2_anchor.tv_sec = anchor_ns / 1000000000;
+		rtp->y2_anchor.tv_nsec = anchor_ns % 1000000000;
+		rtp->y2_anchored = true;
+		return;
+	}
+
+	const int64_t elapsed_ns = (int64_t)(now.tv_sec - rtp->y2_anchor.tv_sec) * 1000000000 +
+		(now.tv_nsec - rtp->y2_anchor.tv_nsec);
+	if (elapsed_ns <= 0)
+		return;
+	const uint64_t real_frames = (uint64_t)elapsed_ns * rtp->ts_pcm_samplerate / 1000000000;
+	const uint64_t slack = (uint64_t)rtp->ts_pcm_samplerate * Y2_RTP_SLACK_MS / 1000;
+	if (real_frames > (uint64_t)rtp->ts_pcm_frames + slack && real_frames <= UINT32_MAX) {
+		debug("RTP timestamp follows real time: +%u PCM frames",
+				(unsigned int)(real_frames - rtp->ts_pcm_frames));
+		rtp->ts_pcm_frames = real_frames;
+	}
+
 }
 
 /**
@@ -99,6 +148,8 @@
 		struct rtp_state *rtp,
 		rtp_header_t *hdr) {
 
+	y2_rtp_follow_real_time(rtp);
+
 	uint32_t timestamp = rtp_convert_clock_rate(rtp->ts_pcm_frames,
 			rtp->ts_pcm_samplerate, rtp->ts_rtp_clockrate) + rtp->ts_offset;
 
