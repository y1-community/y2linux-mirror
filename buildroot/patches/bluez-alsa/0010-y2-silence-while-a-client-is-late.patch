@@ -0,0 +1,59 @@
+/*
+ * Y2Linux - y2-filler.h
+ * SPDX-License-Identifier: MIT
+ *
+ * Silence for an A2DP source stream whose client delivers nothing.
+ *
+ * A started stream carried packets only while its client wrote audio. A
+ * client that was late (a busy player, an underrun and its recovery, a
+ * pause that keeps the PCM open) left the stream started with no packets,
+ * a state phones never put headphones in: AirPods Pro stayed silent after
+ * such a gap until a new stream started (Y2Linux #96, F43, F69). The
+ * player's own silence only helps while the player itself runs on time.
+ *
+ * Now the encoder thread fills in: once a client has played, a stream that
+ * gets no audio for Y2_FILLER_AFTER_MS is fed silence at real time until
+ * audio arrives again, the client drains (the end of its playback) or it
+ * closes the PCM (which stops the stream as before). Pure arithmetic.
+ */
+
+#ifndef Y2_FILLER_H_
+#define Y2_FILLER_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/* How long a client may be late before silence takes its place: longer
+ * than any scheduling delay of a healthy client, shorter than what
+ * headphones keep buffered. The rate synchronization makes this time up
+ * afterwards (y2-catchup.h), so their buffer returns to its level. */
+#define Y2_FILLER_AFTER_MS 100
+
+/**
+ * The poll timeout while waiting for a client's audio.
+ *
+ * @param timeout The timeout the caller would use (-1: none; others belong
+ *   to a drain and are kept).
+ * @param armed A client is attached to an A2DP source stream and has played
+ *   since it opened or last drained.
+ * @param filling The previous transfer already was silence.
+ * @return The timeout in milliseconds, -1 for none. */
+static inline int y2_filler_timeout(int timeout, bool armed, bool filling) {
+	if (timeout != -1 || !armed)
+		return timeout;
+	/* Once filling, every transfer that finds no audio is silence at once:
+	 * the stream keeps real time. */
+	return filling ? 0 : Y2_FILLER_AFTER_MS;
+}
+
+/**
+ * How many samples of silence fit: whole frames only.
+ *
+ * @param space Free samples in the encoder's input buffer.
+ * @param channels Channels of the stream.
+ * @return Samples to fill; 0 when not even one frame fits. */
+static inline size_t y2_filler_samples(size_t space, unsigned int channels) {
+	return channels == 0 ? 0 : space - space % channels;
+}
+
+#endif
