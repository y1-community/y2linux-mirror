+/*
+ * Y2Linux - y2-catchup.h
+ * SPDX-License-Identifier: MIT
+ *
+ * How the rate synchronization treats a stream that is behind real time.
+ *
+ * BlueALSA counts frames from one start time and, when it is behind, sends
+ * without any pause until it has caught up. A radio link that stalls for
+ * three seconds is then followed by three seconds of audio sent as fast as
+ * the link takes it; headphones answer with a dropout and fast playback
+ * (measured on a Y2 with a weak link, 2026-11-10: 2.88 s without a packet,
+ * then 6.1 s of audio in 3 s).
+ *
+ * Phones bound this, and so does this file:
+ *  - at most Y2_CATCHUP_MAX_NS of audio is ever owed: what is behind beyond
+ *    that is forgotten by moving the start time (nothing is skipped in the
+ *    music, the stream just continues from where it stopped);
+ *  - what is owed is sent at no more than 4/3 of real time, so the
+ *    headphones' buffer fills up again without a burst.
+ * A stream that is on time, or late by ordinary scheduling jitter, is paced
+ * exactly as before. Pure arithmetic: no clock, no state.
+ */
+
+#ifndef Y2_CATCHUP_H_
+#define Y2_CATCHUP_H_
+
+#include <stdint.h>
+
+/* The most audio owed after a stall: about what headphones keep buffered. */
+#define Y2_CATCHUP_MAX_NS INT64_C(200000000)
+
+/**
+ * Pacing of one transfer that ended behind real time.
+ *
+ * @param behind_ns How late the stream is, this transfer included (0 or more).
+ * @param transfer_ns Play time of the frames of this transfer.
+ * @param since_last_ns Time since the previous synchronization returned.
+ * @param shift_ns Set to how far the start time moves forward (0 or more).
+ * @return How long to sleep now (0 or more). */
+static inline int64_t y2_catchup(int64_t behind_ns, int64_t transfer_ns,
+		int64_t since_last_ns, int64_t *shift_ns) {
+	*shift_ns = behind_ns > Y2_CATCHUP_MAX_NS ? behind_ns - Y2_CATCHUP_MAX_NS : 0;
+	/* One transfer every 3/4 of its play time is 4/3 of real time. Time
+	 * already spent since the last transfer (encoding, a blocked write, the
+	 * sleep of an on-time transfer) counts, so ordinary jitter adds no
+	 * delay and the stream is never slowed below real time. */
+	const int64_t spacing_ns = transfer_ns / 4 * 3;
+	if (since_last_ns < 0)
+		since_last_ns = 0;
+	return since_last_ns < spacing_ns ? spacing_ns - since_last_ns : 0;
+}
+
+#endif
