 #include "shared/ffb.h"
@@ -149,7 +150,16 @@
 	struct timespec y2_ceiling_seen = { 0 };
 	bool y2_ceiling = false;
 
-	if (ldacBT_init_handle_encode(handle, t->mtu_write, config.ldac_eqmid,
+	/* Y2: with the adaptive rate on, start where this headset settled last
+	 * time (y2-start-level.h: an EQMID, higher is a lower rate); libldac's
