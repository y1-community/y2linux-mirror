--- /dev/null
+++ b/src/y2-start-level.h
@@ -0,0 +1,42 @@
+/*
+ * Y2Linux: where an adapting encoder starts for a headset.
+ *
+ * The adaptive rates (y2-aac-abr.h, libldac's ABR) start at the top level and
+ * step down when the link cannot carry it, so a headset that always settles
+ * lower dropped audio in the first seconds of every stream. The platform's
+ * radio daemon learns the level each headset settled at (EncoderStats) and
+ * keeps it in /run/y2/bt-start/<ADDRESS>-<CODEC>: one number, 0 = the top.
+ * The rate still climbs from there when the link allows.
+ *
+ * This file is free software; you can redistribute it and/or modify it under
+ * the terms of the MIT license. See the COPYING file for details.
+ */
+#ifndef Y2_START_LEVEL_H_
+#define Y2_START_LEVEL_H_
+
+#include <stdio.h>
+
+#include <bluetooth/bluetooth.h>
+
+/* The learned start level for this headset and codec, 0..levels-1 (0 when
+ * there is none). */
+static inline int y2_start_level(const bdaddr_t *addr, const char *codec, int levels) {
+	char address[18];
+	char path[64];
+	ba2str(addr, address);
+	snprintf(path, sizeof(path), "/run/y2/bt-start/%s-%s", address, codec);
+	FILE *file = fopen(path, "r");
+	if (file == NULL)
+		return 0;
+	int level = 0;
+	if (fscanf(file, "%d", &level) != 1)
+		level = 0;
+	fclose(file);
+	if (level < 0)
+		level = 0;
+	if (level >= levels)
+		level = levels - 1;
+	return level;
+}
+
+#endif
