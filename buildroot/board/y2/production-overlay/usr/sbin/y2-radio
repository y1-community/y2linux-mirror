#!/bin/sh
# The radios' switches for scripts (boot, sleep, shutdown): every request goes to the radio daemon
# (y2-radiod ctl), which owns Bluetooth and both radios' power. Without the daemon, sleep and wake
# still switch the radios directly (y2-radiod ctl's fallback).
set -eu
case "${1:-}:${2:-}" in
 wifi:status) exec wpa_cli -i wlan0 status;;
 bluetooth:status) exec bluetoothctl show;;
 wifi:on|wifi:off|wifi:on-runtime|wifi:off-runtime|wifi:restart) ;;
 bluetooth:on|bluetooth:off|bluetooth:on-runtime|bluetooth:off-runtime) ;;
 *) echo 'Usage: y2-radio wifi|bluetooth on|off|on-runtime|off-runtime|status | wifi restart' >&2; exit 2;;
esac
exec /usr/sbin/y2-radiod ctl "$1" "$2"
