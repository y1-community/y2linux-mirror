-#define FS_HANDLE_MAX_FILENAME_SIZE 256
+/* Y2 (#88): 255 UTF-16 units are up to 765 bytes of UTF-8 (CJK, emoji). */
+#define FS_HANDLE_MAX_FILENAME_SIZE 1024
 
 struct fs_entry
 {
